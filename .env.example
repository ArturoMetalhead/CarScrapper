# PLANTILLA de referencia (esta SÍ se versiona; no pongas secretos reales aquí).
# Catálogo de todas las variables configurables con valores de ejemplo.
#
# Los entornos reales son privados (gitignored) y se eligen con DJANGO_ENV:
#   .env.development  -> se carga por defecto (desarrollo local)
#   .env.production   -> se carga con DJANGO_ENV=production
# Copia los valores que necesites a esos archivos (lo que no esté usa el
# valor por defecto de config/settings.py).

# --- Django ---
SECRET_KEY=change-this-to-a-secret-key
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Database (optional). Uses SQLite by default. In production use Postgres.
# DATABASE_URL=postgres://user:password@localhost:5432/carscrapper

# --- Seguridad en producción (solo aplican con DEBUG=False) ---
# Orígenes de confianza para POST (login del admin por HTTPS).
# CSRF_TRUSTED_ORIGINS=https://tudominio.com
# Detrás de un proxy TLS (nginx/balanceador); necesitan HTTPS real:
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# SECURE_HSTS_SECONDS=3600

# --- CORS (allowed frontend) ---
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Scraper ---
# Base URL of the site to scrape.
SCRAPER_BASE_URL=
SCRAPER_TIMEOUT=20
# SCRAPER_USER_AGENT=Mozilla/5.0 ...

# Apply playwright-stealth in browser-based providers.
SCRAPER_USE_STEALTH=True

# Optional proxy (residential or a scraping service) to bypass IP blocks like
# Edmunds'. Format:
#   http://user:password@host:port
SCRAPER_PROXY=

# --- nodriver (anti-DataDome) ---
# Edmunds uses DataDome, which blocks Playwright/Selenium. The Edmunds provider
# uses a real Chrome via nodriver to get through. Requires running from a
# non-flagged (residential) IP and with Chrome installed.
# Profile folder DEDICATED to the scraper (not your personal profile). Persists
# the datadome cookie; defaults to <project>/.chrome_profile_scraper.
# SCRAPER_NODRIVER_PROFILE_DIR=
# Headless is detected/blocked by DataDome; keep this False.
SCRAPER_NODRIVER_HEADLESS=False
# Hide the window off-screen (no visible window) while still passing DataDome.
# This is how to run "in the background". Only applies when HEADLESS is False.
SCRAPER_NODRIVER_HIDE_WINDOW=True
# Retries with reload on a DataDome 403.
SCRAPER_NODRIVER_RETRIES=3
# Seconds to wait after navigating so the JS challenge settles.
SCRAPER_NODRIVER_SETTLE=6

# --- VIN lookup, cache and background queue ---
# Timeout for NHTSA VIN decoding (free, no API key).
SCRAPER_VIN_DECODE_TIMEOUT=15
# Hours the per-model market data is considered fresh (then re-scraped).
SCRAPER_CACHE_TTL_HOURS=24
# Background worker: starts with the API (thread). En producción (worker aparte,
# o contenedor web sin Chromium) déjalo en False. True solo para dev de un nodo.
SCRAPER_WORKER_AUTOSTART=False
# Queue poll (s) and retries per job.
SCRAPER_WORKER_POLL_SECONDS=5
SCRAPER_JOB_MAX_ATTEMPTS=3
# Seconds to wait AFTER each scrape (with jitter). A single residential IP only
# survives LOW volume against DataDome; back-to-back scraping gets it flagged.
# Higher = safer/slower. Only affects throughput, not a single on-demand lookup.
SCRAPER_WORKER_DELAY=300
# On a 403, first rotate the Chrome profile (fresh session/cookie) this many
# times before treating it as an IP-level block. Usually the cookie is what's
# banned (a manual browser on the same IP still works), so this recovers fast.
SCRAPER_BLOCK_ROTATIONS=3
SCRAPER_BLOCK_ROTATE_WAIT=15
# If fresh profiles keep getting blocked (IP-level): back off, doubling up to max.
SCRAPER_BLOCK_COOLDOWN=300
SCRAPER_BLOCK_COOLDOWN_MAX=3600

# --- Background crawler ---
# Proactively discover, scrape and refresh models. The worker self-regulates: on
# a 403 it cools down and resumes automatically when unblocked.
SCRAPER_CRAWL_ENABLED=False
# Makes to crawl (comma-separated; empty = mainstream default list).
SCRAPER_CRAWL_MAKES=
# How many recent model years to cover.
SCRAPER_CRAWL_YEARS_BACK=3
# Planner cycle (s), queue low-water mark, and batch size per cycle (valores
# "gentle" alineados con los defaults; NO subir sin proxies/varias IPs).
SCRAPER_CRAWL_PLAN_INTERVAL=21600
SCRAPER_CRAWL_QUEUE_MIN=5
SCRAPER_CRAWL_BATCH=8
# How long the discovered model list is cached before re-discovering.
SCRAPER_CRAWL_DISCOVERY_TTL_HOURS=24

# --- Frontend notification webhook ---
# URL the backend POSTs to when a scrape finishes (data ready).
# Can be overridden per request with the "webhook_url" field.
SCRAPER_WEBHOOK_URL=
SCRAPER_WEBHOOK_TIMEOUT=10
